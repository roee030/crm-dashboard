# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client. Used by pipeline writes + dev API key path.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AssemblyAI (STT) ----
ASSEMBLYAI_API_KEY=
# Shared secret echoed back in the webhook_auth header so we can verify callbacks.
ASSEMBLYAI_WEBHOOK_SECRET=

# ---- Anthropic Claude (insights) ----
ANTHROPIC_API_KEY=

# ---- CRM (Phase 4) ----
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
# Monday webhook JWT signing secret (from your Monday app) — verifies inbound webhooks.
MONDAY_SIGNING_SECRET=

# ---- App ----
# Public base URL used to build the AssemblyAI webhook callback (prod/tunnel).
# Leave empty in local dev to skip webhooks and use GET /api/calls/[id]/sync-status instead.
APP_URL=
# Encryption key for CRM tokens at rest (Phase 4). 32-byte base64.
ENCRYPTION_KEY=

# ---- Local dev convenience ----
# When set, requests sending header `x-dev-api-key: <this>` may use the service-role
# client and pass an explicit workspace_id, so you can curl the API before auth/UI exist.
# Leave BLANK in any shared/hosted environment.
DEV_API_KEY=
